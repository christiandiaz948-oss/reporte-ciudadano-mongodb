{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "folio",
      "titulo",
      "descripcion",
      "categoria",
      "prioridad",
      "nivelPrioridad",
      "estado",
      "ubicacion",
      "direccion",
      "ciudadanoId",
      "historial",
      "apoyos",
      "totalApoyos",
      "evidencias",
      "etiquetas",
      "fechaCreacion",
      "fechaActualizacion"
    ],
    "properties": {
      "folio": {
        "bsonType": "string",
        "pattern": "^RC-[0-9]{4}-[0-9]{6}$"
      },
      "titulo": {
        "bsonType": "string",
        "minLength": 5,
        "maxLength": 120
      },
      "descripcion": {
        "bsonType": "string",
        "minLength": 10,
        "maxLength": 2000
      },
      "categoria": {
        "enum": [
          "bache",
          "alumbrado",
          "basura",
          "agua_potable",
          "alcantarillado",
          "arbol_caido",
          "semaforo",
          "seguridad_vial",
          "ruido",
          "otro"
        ]
      },
      "prioridad": {
        "enum": [
          "baja",
          "media",
          "alta",
          "critica"
        ]
      },
      "nivelPrioridad": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1,
        "maximum": 4
      },
      "estado": {
        "enum": [
          "recibido",
          "en_revision",
          "asignado",
          "en_proceso",
          "resuelto",
          "rechazado"
        ]
      },
      "ubicacion": {
        "bsonType": "object",
        "required": [
          "latitud",
          "longitud"
        ],
        "properties": {
          "latitud": {
            "bsonType": "double",
            "minimum": 13.1,
            "maximum": 14.5
          },
          "longitud": {
            "bsonType": "double",
            "minimum": -90.2,
            "maximum": -87.6
          }
        }
      },
      "direccion": {
        "bsonType": "object",
        "required": [
          "departamento",
          "municipio"
        ],
        "properties": {
          "departamento": {
            "bsonType": "string"
          },
          "municipio": {
            "bsonType": "string"
          },
          "referencia": {
            "bsonType": [
              "string",
              "null"
            ]
          }
        }
      },
      "ciudadanoId": {
        "bsonType": "objectId"
      },
      "institucion": {
        "bsonType": [
          "object",
          "null"
        ],
        "required": [
          "_id",
          "codigo",
          "nombre"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "codigo": {
            "bsonType": "string"
          },
          "nombre": {
            "bsonType": "string"
          }
        }
      },
      "historial": {
        "bsonType": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "bsonType": "object",
          "required": [
            "estado",
            "fecha",
            "actor"
          ],
          "properties": {
            "estado": {
              "enum": [
                "recibido",
                "en_revision",
                "asignado",
                "en_proceso",
                "resuelto",
                "rechazado"
              ]
            },
            "fecha": {
              "bsonType": "date"
            },
            "actor": {
              "bsonType": "string"
            },
            "comentario": {
              "bsonType": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "evidencias": {
        "bsonType": "array",
        "maxItems": 10,
        "items": {
          "bsonType": "object",
          "required": [
            "url",
            "tipo",
            "fechaSubida"
          ],
          "properties": {
            "url": {
              "bsonType": "string",
              "pattern": "^https?://"
            },
            "tipo": {
              "enum": [
                "foto",
                "video",
                "documento"
              ]
            },
            "fechaSubida": {
              "bsonType": "date"
            }
          }
        }
      },
      "apoyos": {
        "bsonType": "array",
        "items": {
          "bsonType": "objectId"
        }
      },
      "totalApoyos": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 0
      },
      "etiquetas": {
        "bsonType": "array",
        "maxItems": 10,
        "items": {
          "bsonType": "string"
        }
      },
      "calificacion": {
        "bsonType": "object",
        "required": [
          "puntaje",
          "fecha"
        ],
        "properties": {
          "puntaje": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "comentario": {
            "bsonType": [
              "string",
              "null"
            ]
          },
          "fecha": {
            "bsonType": "date"
          }
        }
      },
      "fechaCreacion": {
        "bsonType": "date"
      },
      "fechaActualizacion": {
        "bsonType": "date"
      },
      "fechaResolucion": {
        "bsonType": [
          "date",
          "null"
        ]
      }
    }
  }
}
